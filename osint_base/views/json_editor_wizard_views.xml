<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_json_editor_wizard_form" model="ir.ui.view">
        <field name="name">json.editor.wizard.form</field>
        <field name="model">json.editor.wizard</field>
        <field name="arch" type="xml">
            <form string="Éditer JSON">
                <group>
                    <field name="field_label" readonly="1" string="Champ"/>
                </group>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="field_name" invisible="1"/>
                <field name="json_text" widget="ace" options="{'mode': 'json'}" nolabel="1"/>
                <footer>
                    <button name="action_save" type="object" string="Enregistrer" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_json_editor_wizard" model="ir.actions.act_window">
        <field name="name">Éditer JSON</field>
        <field name="res_model">json.editor.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>