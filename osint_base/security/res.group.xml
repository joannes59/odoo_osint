<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="group_osint_user" model="res.groups">
        <field name="name">OSINT User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_osint_manager" model="res.groups">
        <field name="name">OSINT Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_osint_user'))]" />
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_osint_manager'))]" />
    </record>

</odoo>
