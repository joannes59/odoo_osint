<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_litellm_model_list" model="ir.ui.view">
        <field name="name">litellm.model.list</field>
        <field name="model">litellm.model</field>
        <field name="arch" type="xml">
            <list string="AI Models">
                <header>
                    <button name="action_update_model_support" string="Update Model Support" type="object"/>
                </header>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="parameter_size" optional="hide"/>
                <field name="context_length" optional="hide"/>
                <field name="size" optional="hide"/>
                <field name="authorized" widget="boolean_toggle"/>
                <field name="capability_ids" widget="many2many_tags" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'confirm'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_litellm_model_form" model="ir.ui.view">
        <field name="name">litellm.model.form</field>
        <field name="model">litellm.model</field>
        <field name="arch" type="xml">
            <form string="AI Model">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_update_model_support" string="Update Model Support" type="object"/>
                </header>
                <sheet>
                    <group>
                        <group string="Model">
                            <field name="name"/>
                        </group>
                        <group string="Server">
                            <field name="provider_id"/>
                            <field name="authorized" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Capabilities" name="capabilities">
                            <group>
                                <field name="capability_ids"/>
                            </group>
                        </page>
                        <page string="Details" name="details">
                            <group string="Format">
                                <field name="format"/>
                                <field name="family"/>
                                <field name="response_format"/>
                                <field name="json_schema"/>
                                <field name="model"/>
                            </group>
                            <group string="Sizes">
                                <field name="parameter_size"/>
                                <field name="quantization_level"/>
                                <field name="context_length"/>
                                <field name="embedding_length"/>
                                <field name="size"/>
                                <field name="digest"/>
                            </group>
                        </page>
                        <page string="Description (JSON)" name="description">
                            <field name="description_pretty" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_litellm_model_search" model="ir.ui.view">
        <field name="name">litellm.model.search</field>
        <field name="model">litellm.model</field>
        <field name="arch" type="xml">
            <search string="Search AI Model">
                <field name="name"/>
                <field name="model"/>
                <field name="provider_id"/>
                <field name="family"/>

            </search>
        </field>
    </record>

    <record id="action_litellm_model" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">litellm.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_litellm_model_search"/>
    </record>

    <menuitem id="menu_litellm_model"
              name="Models"
              parent="menu_litellm_root"
              action="action_litellm_model"
              sequence="20"/>
</odoo>
