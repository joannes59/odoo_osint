<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_litellm_provider_list" model="ir.ui.view">
        <field name="name">litellm.provider.list</field>
        <field name="model">litellm.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers">
                <header>
                    <button name="action_update_providers" string="Update Providers" type="object"/>
                </header>
                <field name="name"/>
                <field name="litellm_provider"/>
                <field name="api_type"/>
                <field name="host"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'confirm'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_litellm_provider_form" model="ir.ui.view">
        <field name="name">litellm.provider.form</field>
        <field name="model">litellm.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_sync_models" string="Sync Models" type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Configuration">
                            <field name="name"/>
                            <field name="litellm_provider"/>
                            <field name="api_type"/>

                        </group>
                        <group string="Connection">
                            <field name="host"/>
                            <field name="need_api_key"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models" name="models">
                            <field name="model_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="model"/>
                                    <field name="family"/>
                                    <field name="parameter_size"/>
                                    <field name="quantization_level"/>
                                    <field name="context_length"/>
                                    <field name="capability_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_litellm_provider_search" model="ir.ui.view">
        <field name="name">litellm.provider.search</field>
        <field name="model">litellm.provider</field>
        <field name="arch" type="xml">
            <search string="Search AI Provider">
                <field name="name"/>
                <field name="litellm_provider"/>
                <field name="api_type"/>


            </search>
        </field>
    </record>

    <record id="action_litellm_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">litellm.provider</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_litellm_provider_search"/>
    </record>

    <menuitem id="menu_litellm_provider"
              name="Providers"
              parent="menu_litellm_root"
              action="action_litellm_provider"
              sequence="10"/>
</odoo>
