<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_litellm_session_tree" model="ir.ui.view">
        <field name="name">litellm.session.tree</field>
        <field name="model">litellm.session</field>
        <field name="arch" type="xml">
            <list string="Sessions">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_litellm_session_form" model="ir.ui.view">
        <field name="name">litellm.session.form</field>
        <field name="model">litellm.session</field>
        <field name="arch" type="xml">
            <form string="Session">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Prompts">
                        <field name="prompt_ids">
                            <list>
                                <field name="name"/>
                                <field name="model_id"/>
                                <field name="provider_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_litellm_session_search" model="ir.ui.view">
        <field name="name">litellm.session.search</field>
        <field name="model">litellm.session</field>
        <field name="arch" type="xml">
            <search string="Search Session">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_litellm_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">litellm.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_litellm_session_search"/>
    </record>

    <menuitem id="menu_litellm_session"
              name="Sessions"
              parent="menu_litellm_root"
              action="action_litellm_session"
              sequence="35"/>
</odoo>
