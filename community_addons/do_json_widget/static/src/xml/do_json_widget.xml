<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="do_json_widget.DoJsonWidget">
        <div class="do_json_widget_wrap">
            <div class="do_json_toolbar">
                <input type="text" class="do_json_key_filter" placeholder="Filter keys…" t-att-value="state.filter" t-on-input="onFilterInput" />
                <button class="btn btn-outline-success" t-on-click="expandAll" title="Expand All">
                    <i class="fa fa-expand" /> Expand
                </button>
                <button class="btn btn-outline-warning" t-on-click="collapseAll" title="Collapse All">
                    <i class="fa fa-compress" /> Collapse
                </button>
                <button class="btn btn-outline-secondary" t-on-click="copyJson" title="Copy JSON">
                    <i class="fa fa-copy" /> Copy
                </button>
                <button class="btn btn-outline-info" t-att-class="{'active': state.showRaw}" t-on-click="toggleRaw" title="Toggle Raw JSON">
                    <i class="fa fa-code" /> Raw
                </button>
                <t t-if="!props.readonly and !props.noEditJson">
                    <button class="btn-edit-mode" t-att-class="{'active': state.editMode}" t-on-click="toggleEdit" title="Edit JSON">
                        <i class="fa fa-pencil" /> Edit
                    </button>
                </t>
                <span class="do_json_badge" t-att-class="state.isValid ? 'valid' : 'invalid'">
                    <i t-att-class="state.isValid ? 'fa fa-check-circle' : 'fa fa-times-circle'" />
                    <t t-if="state.isValid">Valid JSON</t>
                    <t t-else="">Invalid JSON</t>
                </span>
            </div>
            <div class="do_json_panel" style="position: relative;">
                <div class="do_json_copy_toast" t-att-class="{'show': state.copyMsg}">
                    ✓ Copied!
                </div>
                <t t-if="state.showRaw">
                    <pre class="do_json_raw"><t t-esc="rawText"/></pre>
                </t>
                <t t-elif="state.editMode">
                    <textarea class="do_json_edit_area" t-att-class="{'invalid': !state.isValid}" t-att-value="state.editText" t-on-input="onEditInput" placeholder="Enter valid JSON…" />
                    <div t-if="state.editError" class="do_json_edit_error">
                        <i class="fa fa-exclamation-triangle"/> <t t-esc="state.editError"/>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-sm btn-primary" t-on-click="applyEdit">
                            <i class="fa fa-check"/> Apply
                        </button>
                        <button class="btn btn-sm btn-secondary" t-on-click="cancelEdit">
                            <i class="fa fa-times"/> Cancel
                        </button>
                    </div>
                </t>

                <t t-else="">
                    <div class="do_json_structure_header">
                        <i class="fa fa-eye"/>
                        <span>JSON Structure</span>
                    </div>

                    <t t-if="isEmpty">
                        <div class="text-muted" style="font-size:12px; padding: 4px 0;">
                            <i class="fa fa-inbox"/> No data
                        </div>
                    </t>
                    <div class="do_json_tree">
                        <t t-foreach="state.rows" t-as="row" t-key="row.id">

                            <t t-if="row.type === 'object' or row.type === 'array'">
                                <div class="do_json_node"
                                     t-att-style="this.indentStyle(row.depth)"
                                     t-att-class="{'root': row.depth &lt; 0}">

                                    <span
                                        class="do_json_toggler"
                                        t-att-class="{'collapsed': row.collapsed}"
                                        t-on-click.stop="() => this.toggleNode(row.id)">
                                        <i class="fa fa-caret-down caret"/>
                                    </span>

                                    <span class="do_json_key"
                                          t-att-class="{'highlight': state.filter and row.matchesFilter}">
                                        <t t-esc="row.key"/>
                                    </span>

                                    <span class="do_json_sep"> : </span>
                                    <span class="do_json_val_obj">
                                        <t t-esc="row.label"/>
                                    </span>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="do_json_node"
                                     t-att-style="this.indentStyle(row.depth)">

                                    <span class="do_json_toggler" style="visibility:hidden;">
                                        <i class="fa fa-caret-down caret"/>
                                    </span>

                                    <span class="do_json_key"
                                          t-att-class="{'highlight': state.filter and row.matchesFilter}">
                                        <t t-esc="row.key"/>
                                    </span>
                                    <span class="do_json_sep"> : </span>
                                    <span t-att-class="this.valueClass(row)">
                                        <t t-esc="this.valueLabel(row)"/>
                                    </span>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>