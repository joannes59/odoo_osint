<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_osint_url_list" model="ir.ui.view">
        <field name="name">osint.url.list</field>
        <field name="model">osint.url</field>
        <field name="arch" type="xml">
            <list string="URLs">
                <field name="website_id"/>
                <field name="name" widget="url"/>
            </list>
        </field>
    </record>

    <record id="view_osint_url_form" model="ir.ui.view">
        <field name="name">osint.url.form</field>
        <field name="model">osint.url</field>
        <field name="arch" type="xml">
            <form string="URL">
                <sheet>
                    <group string="URL">
                        <field name="website_id"/>
                        <field name="name"/>
                    </group>
                    <group string="Components">
                        <group>
                            <field name="scheme"/>
                            <field name="path"/>
                        </group>
                        <group>
                            <field name="params"/>
                            <field name="query"/>
                            <field name="fragment"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_osint_url_search" model="ir.ui.view">
        <field name="name">osint.url.search</field>
        <field name="model">osint.url</field>
        <field name="arch" type="xml">
            <search string="Search URL">
                <field name="website_id"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_osint_url" model="ir.actions.act_window">
        <field name="name">URLs</field>
        <field name="res_model">osint.url</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_osint_url_search"/>
    </record>

    <menuitem id="menu_osint_url"
              name="URLs"
              parent="menu_website_root"
              action="action_osint_url"
              sequence="20"/>
</odoo>
