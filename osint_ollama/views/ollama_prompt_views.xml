<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ollama_prompt_tree" model="ir.ui.view">
        <field name="name">ollama.prompt.tree</field>
        <field name="model">ollama.prompt</field>
        <field name="arch" type="xml">
            <list string="Prompts">
                <field name="name"/>
                <field name="model_id"/>
                <field name="provider_id"/>
            </list>
        </field>
    </record>

    <record id="view_ollama_prompt_form" model="ir.ui.view">
        <field name="name">ollama.prompt.form</field>
        <field name="model">ollama.prompt</field>
        <field name="arch" type="xml">
            <form string="Prompt">
                <header>
                    <button name="action_send" string="Send" type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Configuration">
                            <field name="model_id"/>
                            <field name="provider_id"/>
                        </group>
                    </group>
                    <group string="Messages">
                        <field name="message_ids">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="role"/>
                                <field name="content"/>
                                <field name="eval_count"/>                                
                                <field name="total_duration"/>
                            </list>
                            <form>
                                <group>
                                    <field name="role"/>
                                    <field name="content"/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group colspan="2">
                        <group string="Question">
                            <field name="question" colspan="2" nolabel="1"
                                   placeholder="Enter your question here..."/>
                        </group>
                    </group>
                    <group colspan="2">
                        <group string="Response">
                            <field name="response" colspan="2" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ollama_prompt_search" model="ir.ui.view">
        <field name="name">ollama.prompt.search</field>
        <field name="model">ollama.prompt</field>
        <field name="arch" type="xml">
            <search string="Search Prompt">
                <field name="name"/>
                <field name="model_id"/>
                <field name="provider_id"/>
            </search>
        </field>
    </record>

    <record id="action_ollama_prompt" model="ir.actions.act_window">
        <field name="name">Prompts</field>
        <field name="res_model">ollama.prompt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ollama_prompt_search"/>
    </record>

    <menuitem id="menu_ollama_prompt"
              name="Prompts"
              parent="menu_ollama_root"
              action="action_ollama_prompt"
              sequence="40"/>
</odoo>
