<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ollama_model_list" model="ir.ui.view">
        <field name="name">ollama.model.list</field>
        <field name="model">ollama.model</field>
        <field name="arch" type="xml">
            <list string="AI Models">
                <field name="name"/>
                <field name="model"/>
                <field name="provider_id"/>
                <field name="family"/>
                <field name="parameter_size"/>
                <field name="quantization_level"/>
                <field name="context_length"/>
                <field name="size" optional="show"/>
                <field name="capability_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ollama_model_form" model="ir.ui.view">
        <field name="name">ollama.model.form</field>
        <field name="model">ollama.model</field>
        <field name="arch" type="xml">
            <form string="AI Model">
                <sheet>
                    <group>
                        <group string="Model">
                            <field name="name"/>
                            <field name="model"/>
                            <field name="description"/>
                            <field name="digest"/>
                        </group>
                        <group string="Server">
                            <field name="provider_id"/>
                            <field name="size"/>
                        </group>
                    </group>
                    <group string="Details">
                        <group string="Format">
                            <field name="format"/>
                            <field name="family"/>
                        </group>
                        <group string="Sizes">
                            <field name="parameter_size"/>
                            <field name="quantization_level"/>
                            <field name="context_length"/>
                            <field name="embedding_length"/>
                        </group>
                    </group>
                    <group string="Capabilities">
                        <field name="capability_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ollama_model_search" model="ir.ui.view">
        <field name="name">ollama.model.search</field>
        <field name="model">ollama.model</field>
        <field name="arch" type="xml">
            <search string="Search AI Model">
                <field name="name"/>
                <field name="model"/>
                <field name="provider_id"/>
                <field name="family"/>
            </search>
        </field>
    </record>

    <record id="action_ollama_model" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">ollama.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ollama_model_search"/>
    </record>

    <menuitem id="menu_ollama_model"
              name="Models"
              parent="menu_ollama_root"
              action="action_ollama_model"
              sequence="20"/>
</odoo>
