<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_litellm_prompt_mcp_form" model="ir.ui.view">
        <field name="model">litellm.prompt</field>
        <field name="inherit_id" ref="osint_litellm.view_litellm_prompt_form"/>
        <field name="arch" type="xml">

            <page name="system_message" position="after">
                <page string="MCP server" name="mcp_server">
                    <group string="MCP Server">
                        <field name="mcp_ids"/>  
                    </group>
                </page>
            </page>                        

        </field>
    </record>

</odoo>
