<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fastmcp_server_list" model="ir.ui.view">
        <field name="name">fastmcp.server.list</field>
        <field name="model">fastmcp.server</field>
        <field name="arch" type="xml">
            <list string="MCP Servers">
                <field name="name"/>
                <field name="server_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fastmcp_server_form" model="ir.ui.view">
        <field name="name">fastmcp.server.form</field>
        <field name="model">fastmcp.server</field>
        <field name="arch" type="xml">
            <form string="MCP Server">
                <header>
                    <button name="action_fetch_metadata" string="Sync Capabilities"
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Server">
                            <field name="name"/>

                            <field name="active"/>
                        </group>
                        <group string="Connection">
                            <field name="server_url"/>
   
                       
                        </group>
                    </group>

                    <notebook>
                        <page string="Tools">
                            <field name="tool_ids">
                                <list string="MCP Tools">
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="title"/>
                                        <field name="description"/>
                                        <field name="input_schema_pretty"/>
                                        <field name="output_schema"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Resources">
                            <field name="resource_ids">
                                <list string="MCP Resources">
                                    <field name="name"/>
                                    <field name="uri"/>
                                    <field name="mime_type"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="uri"/>
                                        <field name="description"/>
                                        <field name="mime_type"/>
                                        <field name="size"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Prompts">
                            <field name="prompt_ids">
                                <list string="MCP Prompts">
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="title"/>
                                        <field name="description"/>
                                        <field name="arguments"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="API Keys">
                            <field name="apikey_ids">
                                <list string="API Keys">
                                    <field name="name"/>
                                    <field name="apikey"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="group_ids" widget="many2many_tags"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="apikey"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                        <field name="group_ids" widget="many2many_tags"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fastmcp_server_search" model="ir.ui.view">
        <field name="name">fastmcp.server.search</field>
        <field name="model">fastmcp.server</field>
        <field name="arch" type="xml">
            <search string="Search MCP Server">
                <field name="name"/>
                <field name="active"/>
            </search>
        </field>
    </record>

    <record id="action_fastmcp_server" model="ir.actions.act_window">
        <field name="name">MCP Servers</field>
        <field name="res_model">fastmcp.server</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fastmcp_server_search"/>
    </record>

    <menuitem id="menu_fastmcp_server"
              name="MCP Servers"
              parent="osint_litellm.menu_litellm_root"
              action="action_fastmcp_server"
              sequence="45"/>
</odoo>
