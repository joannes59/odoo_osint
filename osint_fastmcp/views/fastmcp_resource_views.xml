<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fastmcp_resource_list" model="ir.ui.view">
        <field name="name">fastmcp.resource.list</field>
        <field name="model">fastmcp.resource</field>
        <field name="arch" type="xml">
            <list string="MCP Resources">
                <field name="name"/>
                <field name="uri"/>
                <field name="mime_type"/>
                <field name="size"/>
            </list>
        </field>
    </record>

    <record id="view_fastmcp_resource_form" model="ir.ui.view">
        <field name="name">fastmcp.resource.form</field>
        <field name="model">fastmcp.resource</field>
        <field name="arch" type="xml">
            <form string="MCP Resource">
                <sheet>
                    <group>
                        <group string="Resource">
                            <field name="name"/>
                            <field name="title"/>
                            <field name="mcp_server_id"/>
                            <field name="uri"/>
                        </group>
                        <group string="Details">
                            <field name="mime_type"/>
                            <field name="size"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fastmcp_resource_search" model="ir.ui.view">
        <field name="name">fastmcp.resource.search</field>
        <field name="model">fastmcp.resource</field>
        <field name="arch" type="xml">
            <search string="Search MCP Resource">
                <field name="name"/>
                <field name="uri"/>
                <field name="mcp_server_id"/>
            </search>
        </field>
    </record>

    <record id="action_fastmcp_resource" model="ir.actions.act_window">
        <field name="name">MCP Resources</field>
        <field name="res_model">fastmcp.resource</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fastmcp_resource_search"/>
    </record>

    <menuitem id="menu_fastmcp_resource"
              name="Resources"
              parent="osint_fastmcp.menu_fastmcp_root"
              action="action_fastmcp_resource"
              sequence="30"/>
</odoo>
