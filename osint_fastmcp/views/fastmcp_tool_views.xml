<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fastmcp_tool_list" model="ir.ui.view">
        <field name="name">fastmcp.tool.list</field>
        <field name="model">fastmcp.tool</field>
        <field name="arch" type="xml">
            <list string="MCP Tools">
                <field name="mcp_server_id"/>
                <field name="name"/>
                <field name="title"/>
                
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_fastmcp_tool_form" model="ir.ui.view">
        <field name="name">fastmcp.tool.form</field>
        <field name="model">fastmcp.tool</field>
        <field name="arch" type="xml">
            <form string="MCP Tool">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="title"/>
                        </group>
                        <group>
                            <field name="mcp_server_id"/>
                            <field name="enabled" widget="boolean_toggle"/>
                        </group>
                    </group>

                        

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" widget="text"/>
                        </page>
                        <page string="Input Schema" name="input_schema">
                            <field name="input_schema_pretty" widget="text"/>
                        </page>
                        <page string="Output Schema" name="output_schema">
                            <field name="output_schema" widget="text"/>
                        </page>
                        <page string="Annotations" name="annotations">
                            <field name="annotations" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fastmcp_tool_search" model="ir.ui.view">
        <field name="name">fastmcp.tool.search</field>
        <field name="model">fastmcp.tool</field>
        <field name="arch" type="xml">
            <search string="Search MCP Tool">
                <field name="name"/>
                <field name="title"/>
                <field name="mcp_server_id"/>
            </search>
        </field>
    </record>

    <record id="action_fastmcp_tool" model="ir.actions.act_window">
        <field name="name">MCP Tools</field>
        <field name="res_model">fastmcp.tool</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fastmcp_tool_search"/>
    </record>

    <menuitem id="menu_fastmcp_tool"
              name="Tools"
              parent="osint_fastmcp.menu_fastmcp_root"
              action="action_fastmcp_tool"
              sequence="20"/>
</odoo>
