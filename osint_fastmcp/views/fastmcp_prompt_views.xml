<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fastmcp_prompt_list" model="ir.ui.view">
        <field name="name">fastmcp.prompt.list</field>
        <field name="model">fastmcp.prompt</field>
        <field name="arch" type="xml">
            <list string="MCP Prompts">
                <field name="name"/>
                <field name="title"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_fastmcp_prompt_form" model="ir.ui.view">
        <field name="name">fastmcp.prompt.form</field>
        <field name="model">fastmcp.prompt</field>
        <field name="arch" type="xml">
            <form string="MCP Prompt">
                <sheet>
                    <group>
                        <group string="Prompt">
                            <field name="name"/>
                            <field name="title"/>
                            <field name="mcp_server_id"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" widget="text"/>
                    </group>
                    <group string="Arguments">
                        <field name="arguments" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fastmcp_prompt_search" model="ir.ui.view">
        <field name="name">fastmcp.prompt.search</field>
        <field name="model">fastmcp.prompt</field>
        <field name="arch" type="xml">
            <search string="Search MCP Prompt">
                <field name="name"/>
                <field name="title"/>
                <field name="mcp_server_id"/>
            </search>
        </field>
    </record>

    <record id="action_fastmcp_prompt" model="ir.actions.act_window">
        <field name="name">MCP Prompts</field>
        <field name="res_model">fastmcp.prompt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fastmcp_prompt_search"/>
    </record>

    <menuitem id="menu_fastmcp_prompt"
              name="Prompts"
              parent="osint_fastmcp.menu_fastmcp_root"
              action="action_fastmcp_prompt"
              sequence="40"/>
</odoo>
