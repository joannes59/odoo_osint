<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_litellm_mcp_server_list" model="ir.ui.view">
        <field name="name">litellm.mcp.server.list</field>
        <field name="model">litellm.mcp.server</field>
        <field name="arch" type="xml">
            <list string="MCP Servers">
                <field name="name"/>
                <field name="server_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_litellm_mcp_server_form" model="ir.ui.view">
        <field name="name">litellm.mcp.server.form</field>
        <field name="model">litellm.mcp.server</field>
        <field name="arch" type="xml">
            <form string="MCP Server">
                <header>
                    <button name="action_fetch_metadata" string="Sync Capabilities"
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Server">
                            <field name="name"/>

                            <field name="active"/>
                        </group>
                        <group string="Connection">
                            <field name="server_url"/>
   
                       
                        </group>
                    </group>

                    <notebook>
                        <page string="Tools">
                            <field name="tool_ids">
                                <list string="MCP Tools">
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="title"/>
                                        <field name="description"/>
                                        <field name="input_schema"/>
                                        <field name="output_schema"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Resources">
                            <field name="resource_ids">
                                <list string="MCP Resources">
                                    <field name="name"/>
                                    <field name="uri"/>
                                    <field name="mime_type"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="uri"/>
                                        <field name="description"/>
                                        <field name="mime_type"/>
                                        <field name="size"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Prompts">
                            <field name="prompt_ids">
                                <list string="MCP Prompts">
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="title"/>
                                        <field name="description"/>
                                        <field name="arguments"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_litellm_mcp_server_search" model="ir.ui.view">
        <field name="name">litellm.mcp.server.search</field>
        <field name="model">litellm.mcp.server</field>
        <field name="arch" type="xml">
            <search string="Search MCP Server">
                <field name="name"/>
                <field name="active"/>
            </search>
        </field>
    </record>

    <record id="action_litellm_mcp_server" model="ir.actions.act_window">
        <field name="name">MCP Servers</field>
        <field name="res_model">litellm.mcp.server</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_litellm_mcp_server_search"/>
    </record>

    <menuitem id="menu_litellm_mcp_server"
              name="MCP Servers"
              parent="osint_litellm.menu_litellm_root"
              action="action_litellm_mcp_server"
              sequence="45"/>
</odoo>
