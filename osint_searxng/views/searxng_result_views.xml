<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_searxng_result_list" model="ir.ui.view">
        <field name="name">searxng.result.list</field>
        <field name="model">searxng.result</field>
        <field name="arch" type="xml">
            <list string="Search Results">
                <field name="title"/>
                <field name="url" widget="url"/>
                <field name="engine"/>
                <field name="category"/>
                <field name="score"/>
                <field name="published_date"/>
                <field name="query_id"/>
            </list>
        </field>
    </record>

    <record id="view_searxng_result_form" model="ir.ui.view">
        <field name="name">searxng.result.form</field>
        <field name="model">searxng.result</field>
        <field name="arch" type="xml">
            <form string="Search Result">
                <sheet>
                    <group>
                        <group string="Result">
                            <field name="title"/>
                            <field name="url" widget="url"/>
                            <field name="content"/>
                        </group>
                        <group string="Metadata">
                            <field name="engine"/>
                            <field name="category"/>
                            <field name="template"/>
                            <field name="score"/>
                            <field name="priority"/>
                            <field name="published_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Media">
                            <field name="thumbnail"/>
                            <field name="img_src"/>
                        </group>
                        <group string="Technical">
                            <field name="query_id"/>
                            <field name="engines" widget="json"/>
                            <field name="parsed_url" widget="json"/>
                            <field name="positions" widget="json"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_searxng_result" model="ir.actions.act_window">
        <field name="name">Search Results</field>
        <field name="res_model">searxng.result</field>
        <field name="view_mode">list,form</field>
        
    </record>

    <menuitem id="menu_searxng_result"
              name="Results"
              parent="menu_searxng_root"
              action="action_searxng_result"
              sequence="30"/>
</odoo>
