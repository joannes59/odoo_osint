<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_searxng_result_list" model="ir.ui.view">
        <field name="name">searxng.result.list</field>
        <field name="model">searxng.result</field>
        <field name="arch" type="xml">
            <list string="Search Results">
                <field name="website_id"/>
                <field name="title"/>
                <field name="category"/>
                <field name="content"/>
                <field name="score"/>
                <field name="query_id"/>
            </list>
        </field>
    </record>

    <record id="view_searxng_result_form" model="ir.ui.view">
        <field name="name">searxng.result.form</field>
        <field name="model">searxng.result</field>
        <field name="arch" type="xml">
            <form string="Search Result">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Title of the page ..." readonly="1"/>
                        </h1>
                        <field name="content" readonly="1"/>
                    </div>
                    <group>
                        <field name="url_id" readonly="1"/>
                        <field name="query_id" readonly="1"/>
                    </group>
                    
                    <notebook>
                        <page string="Media" name="media">
                            <group>
                                <field name="thumbnail"/>
                                <field name="img_src"/>
                            </group>        
                        </page>
                        <page string="Metadata" name="metadata">
                                <group string="Metadata">
                                    <field name="engine"/>
                                    <field name="category"/>
                                    <field name="score"/>
                                    <field name="priority"/>
                                    <field name="published_date"/>
                                </group>
                        </page>
                    </notebook>
                
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_searxng_result" model="ir.actions.act_window">
        <field name="name">Search Results</field>
        <field name="res_model">searxng.result</field>
        <field name="view_mode">list,form</field>
        
    </record>

    <menuitem id="menu_searxng_result"
              name="Results"
              parent="menu_searxng_root"
              action="action_searxng_result"
              sequence="30"/>
</odoo>
