<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_searxng_result_list" model="ir.ui.view">
        <field name="name">searxng.result.list</field>
        <field name="model">searxng.result</field>
        <field name="arch" type="xml">
            <list string="Search Results">
                <field name="date"/>
                <field name="query_id"/>
                <field name="website_id"/>
                <field name="engine"/>
                <field name="score"/>
            </list>
        </field>
    </record>

    <record id="view_searxng_result_form" model="ir.ui.view">
        <field name="name">searxng.result.form</field>
        <field name="model">searxng.result</field>
        <field name="arch" type="xml">
            <form string="Search Result">
                <sheet>

                    <group>
                        <field name="url_id" readonly="1"/>
                        <field name="query_id" readonly="1"/>
                                        <field name="date"/>
                                        <field name="query_id"/>
                                        <field name="website_id"/>
                                        <field name="engine"/>
                                        <field name="score"/>
                    </group>
                                    
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_searxng_result" model="ir.actions.act_window">
        <field name="name">Search Results</field>
        <field name="res_model">searxng.result</field>
        <field name="view_mode">list,form</field>
        
    </record>

    <menuitem id="menu_searxng_result"
              name="Results"
              parent="menu_searxng_root"
              action="action_searxng_result"
              sequence="30"/>
</odoo>
