<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_osint_agent_skill_parameter_list" model="ir.ui.view">
        <field name="name">osint.agent.skill.parameter.list</field>
        <field name="model">osint.agent.skill.parameter</field>
        <field name="arch" type="xml">
            <list string="Agent Skill Parameters">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parameter_type" widget="badge"/>
                <field name="skill_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_osint_agent_skill_parameter_form" model="ir.ui.view">
        <field name="name">osint.agent.skill.parameter.form</field>
        <field name="model">osint.agent.skill.parameter</field>
        <field name="arch" type="xml">
            <form string="Agent Skill Parameter">
                <sheet>
                    <group>
                        <group string="Parameter">
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="parameter_type"/>
                        </group>
                        <group string="Skills">
                            <field name="skill_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_osint_agent_skill_parameter_search" model="ir.ui.view">
        <field name="name">osint.agent.skill.parameter.search</field>
        <field name="model">osint.agent.skill.parameter</field>
        <field name="arch" type="xml">
            <search string="Search Agent Skill Parameter">
                <field name="name"/>
                <field name="parameter_type"/>
                <field name="skill_ids"/>
            </search>
        </field>
    </record>

    <record id="action_osint_agent_skill_parameter" model="ir.actions.act_window">
        <field name="name">Skill Parameters</field>
        <field name="res_model">osint.agent.skill.parameter</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_osint_agent_skill_parameter_search"/>
    </record>

    <menuitem id="menu_osint_agent_skill_parameter"
              name="Skill Parameters"
              parent="osint_agent.menu_osint_agent"
              action="action_osint_agent_skill_parameter"
              sequence="70"/>
</odoo>